    "framer-motion": "^12.38.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.1",
    "topojson-client": "^3.1.0",
    "vite": "^6.2.0",
    "world-atlas": "^2.0.2"
  },
